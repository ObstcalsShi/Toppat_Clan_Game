{
        "id": 5000002,             //未被使用的数字50开头的7位数id
        "name": "弑君",//仪式标题
        "text": "reg准备安排刺杀帮主",  //仪式启动界面正文
        "tips": "",//策划看的备注
        "once_new":-1,
        //用来设置仪式出现在桌面上图标的表现
        //配置为0：每次出现在桌面上时先显示【?】图标，用来让玩家理解是先刷出的仪式
        //配置为1：只有在第1次出现时显示【?】图标。下次再刷新会正常显示仪式自身的图标
        //配置为-1：每次出现都只显示仪式自身的图标
        "round_number": 0,
        //仪式执行的回合数
        //配置为0代表仪式执行后立即结算，不用过回合
        "waiting_round":0,
        //仪式在执行前，在桌面停留的回合数，回合数一过默认仪式会被移除
        //配置为0代表仪式在执行前会一直停留在桌面
        "waiting_round_end_action":[
	        {
                "condition": {
                },
                "result_title":"", //这个参数在这里没有用，玩家看不到，所以不用配置
                "result_text": "",//这个参数在这里没有用，玩家看不到，所以不用配置
                "result":
                {
                },
                "action": {
                }
            }
        ],
        "method_settlement": "", //参数要保留，但没有用，不用配置
        "auto_begin": 0,
        //用来配置仪式过回合时是否会自动执行
        //配置1为会自动执行，配置为0代表不会自动执行
        "auto_result":0,
        //用来配置是否显示跳过仪式结算界面的开关
        //配置为1显示，配置为0不显示
        "location": "宫廷:[2,9]",
        //仪式生成时在桌面上的坐标位置
        //可以从已有的坐标中选择配置
        //目前暂不开放新坐标的编辑
        "icon": "rite5000002",
        //仪式的图标，配置对应图标的资源名。对应资源的放置在mod要求的对应文件地址中
        "tag_tips": [
	        //参数要保留，但没有用，不用配置
        ],
        "tag_tips_up":{
	        //用来提示玩家仪式内有哪些标签会参加结果检定
        	//如果没有检定内容的话可以不配置
        	"tips":["战斗","体魄"], //这个仪式会检定战斗和体魄两个tag
            "type":"fight_result"
            //因为是对抗性质的检定，检定骰子的公式里设计到减值，所以这里用fight_result
            //如果不涉及到减值，这里用normal_result
        },
        "tips_text":[
	        //仪式的提示文本
        	//如果提示文本的话可以不配置
          "弑君失败会死亡"
//            "决斗失败的一方会死亡。" //提示玩家打不过就会死，最好做足充足装备再来
        ],
        "open_conditions": [
           //仪式额外需要满足的启动执行的条件
           //详细见范例1
            {
                "condition": {
                    "counter.8000001":1  // 检测计数器，拥有金招安思潮是否为1
                },
                "tips": "仪式开启需要有金招安思潮"
            }
        ],
        "random_text":{
	        //参数要保留，但没有用，不用配置
        },
        "random_text_up":{
	        //创建骰子检定的编号，和对应的提示文本
        	//如果没有骰子检定的话可以不配置
        	"r1":{
                "text":"你一个箭步一刀向对方的脖子上砍去", //投骰子前的文本
                "type":"fight_result", //设计者觉得这里可以先不对抗，所以用normal
                "type_tips":"你的战斗为你提供了完整的骰子数量。", //提示文本
                "low_target": 1,
                //最小成功数，玩家进行检定时，根据实际成功数和最小成功数比较会在UI上有提示
                "low_target_tips": "你至少需要1点成功才能打败对方。" //用于提示
            }
        },
        "settlement_prior": [
        ],
        "settlement": [
        ],
        "settlement_extre": [
            //仪式结算的结果在这里配置
        	//如果没有执行settlement_prior，此处的结果只要满足条件都会结算
        	//结算顺序从上至下
            {
                "condition": {
                    "r1:战斗>=":[1,5]
                    //进行编号r1骰子检定，投友方的战斗骰子，如果成功数大于等于1
                },
                "result_title":"",
                "result_text": "[s1.name]虽然勉力向后躲闪，但你凭着出人意料的速度和技巧，依然打败了对方。",
                "result":
                {
                    "clean.s1": 1
                },
                "action": {}
            },
            {
                  "condition": {
                      "r1:战斗<":[1,5]//投友方的战斗骰子，如果成功数如果小于1
                  },
                  "result_title":"",
                  "result_text": "你的出击没能收到成效，对方反手用刀划过你的脖子，你死了。",
                  "result":
                  {
//                    "global_counter=7200110":1, //成就
                    "clean.s2": 1
                  },
                  "action": {}
            }
        ],
        "cards_slot": //仪式界面上的槽位配置，玩家可以操作的部分，也是仪式检定的主体
        {
            "s1":
            {
                "condition":
                {
                    "type":"char", //对方需要是个char类型的卡
                    "礼貌帮帮主": 1, // 类型type可以选sudan，这个tag就不要加了 // 怕会和游戏冲突，另外做一个tag帮主
                },
                "open_adsorb":1, //自动吸附一个对决对手
                "is_key":0,
                "is_empty":0,
                //因为不能为空，所以如果吸不到满足条件的对手，仪式就不能成功生成
                "is_enemy":1, //标识了敌人
                "text":"你不得不面对的敌人"
            },
            "s2":
            {
                "condition":
                {
                    "type":"char",//你派遣的人需要是个char类型的卡
                    "自己": 1
                },
                "open_adsorb":0, //非自动吸附，所以你可以自己选择合适的人选
                "is_key":0,
                "is_empty":0, //你派遣人去，这个仪式才能启动
                "is_enemy":0, //这是友方
                "text":"你必须亲自战胜帮主"
            },
        }
    }