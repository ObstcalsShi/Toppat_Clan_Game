{
        "id": 5000001, //未被使用的数字50开头的7位数id
        "name": "刺杀ter",//仪式标题
        "text": "吸附不在手牌中的ter",  //仪式启动界面正文
        "tips": "",//策划看的备注
        "once_new":-1,
        //用来设置仪式出现在桌面上图标的表现
        //配置为0：每次出现在桌面上时先显示【?】图标，用来让玩家理解是先刷出的仪式
        //配置为1：只有在第1次出现时显示【?】图标。下次再刷新会正常显示仪式自身的图标
        //配置为-1：每次出现都只显示仪式自身的图标
        "round_number": 0,
        //仪式执行的回合数
        //配置为0代表仪式执行后立即结算，不用过回合
        "waiting_round":0,
        //仪式在执行前，在桌面停留的回合数，回合数一过默认仪式会被移除
        //配置为0代表仪式在执行前会一直停留在桌面
        "waiting_round_end_action":[
	        //仪式在停留时间结束时会立即执行的动作，可以不配置
	        //详细见范例1
        ],
        "method_settlement": "", //参数要保留，但没有用，不用配置
        "auto_begin": 0,
        //用来配置仪式过回合时是否会自动执行
        //配置1为会自动执行，配置为0代表不会自动执行
        // 等待玩家x回合的一般不会自动执行这个仪式
        "auto_result":0,
        //用来配置是否显示跳过仪式结算界面的开关
        //配置为1显示，配置为0不显示
        "location": "宫廷:[2,6]",
        //仪式生成时在桌面上的坐标位置
        //可以从已有的坐标中选择配置
        //目前暂不开放新坐标的编辑
        "icon": "rite_5000001",
        //仪式的图标，配置对应图标的资源名。对应资源的放置在mod要求的对应文件地址中
        "tag_tips": [
	        //参数要保留，但没有用，不用配置
        ],
        "tag_tips_up":{
	        //用来提示玩家仪式内有哪些标签会参加结果检定
        	//如果没有检定内容的话可以不配置
        	//详细见范例1
        },
        "tips_text":[
          "第一次决斗，测试吸附不在手牌中的ter，测试在手牌空闲的charlie能不能改属性"
        ],
        "open_conditions": [
           //仪式额外需要满足的启动执行的条件
           //详细见范例1
        ],
        "random_text":{//参数要保留，但没有用，不用配置
        },
        "random_text_up":{
	        "r1":{
                "text":"一刀向对方的脖子上砍去", //投骰子前的文本
                "type":"fight_result", //设计者觉得这里可以先不对抗，所以用normal
                "type_tips":"你的战斗为你提供了完整的骰子数量。reg", //提示文本
                "low_target": 1,
                //最小成功数，玩家进行检定时，根据实际成功数和最小成功数比较会在UI上有提示
                "low_target_tips": "你至少需要1点成功才能让对方受伤。" //用于提示
            }
        },
        "settlement_prior": [
        ],
        "settlement": [
        ],
        "settlement_extre": [
          {
                "condition": {
                    "r1:战斗>=":[1,5]
                    //进行编号r1骰子检定，投友方的战斗骰子，如果成功数大于等于1
                },
                "result_title":"",
                "result_text": "[s1.name]虽然勉力向后躲闪，但你凭着出人意料的速度和技巧，依然击伤了对方。",
                "result":
                {
                    "s1+equip": 2000098
                    //s1装备2000098（受伤）
                    //因为reuslt配置的动作不会立即生效，s1不会因为受伤影响后续的数值检定。
                    //所以这里只用作剧情表现
                },
                "action": {
                  "table.2000001+体魄":3
                }
            },
          {
                "condition": {
                    "r1:战斗<":[1,5]//投友方的战斗骰子，如果成功数如果小于1
                },
                "result_title":"",
                "result_text": "你的出击没能收到成效，对方从容地躲过了这一击。",
                "result":
                {
                },
                "action": {
                  "table.2000001-体魄":3
                }
            },
        ],
        "cards_slot": //仪式界面上的槽位配置，玩家可以操作的部分，也是仪式检定的主体
        {
            "s1": //槽位1
                {
                "condition":
                {
                    "type":"礼貌帮帮主", //对方需要是个char类型的卡
                },
                "open_adsorb":1, //自动吸附一个对决对手
                "is_key":0,
                "is_empty":0,
                //因为不能为空，所以如果吸不到满足条件的对手，仪式就不能成功生成
                "is_enemy":1, //标识了敌人
                "text":"这是你昨天选定的决斗对手"
            },
            "s2": //槽位2
                {
                "condition":
                {
                    "type":"自己",//你派遣的人需要是个char类型的卡
                    "贵族": 1     //你派遣的人需要有贵族这个tag
                },
                "open_adsorb":0, //非自动吸附，所以你可以自己选择合适的人选
                "is_key":0,
                "is_empty":0, //你派遣人去，这个仪式才能启动
                "is_enemy":0, //这是友方
                "text":"你可以亲自，或者挑选一名贵族追随者替你赴战"
            }
        }
    }