{
  "ToppatClan": {
        //tag的英文名称，不可重复
        "id": 3000001,
        //未被使用的数字3开头的7位数作为id的卡牌
        "name": "礼貌帮",
        //tag的名称，直接使用中文
        "code": "ToppatClan",
        //tag的英文名称，同上
        "type": "attribute",
        //目前分为 buff 和 attribute 两类
        //一般可堆叠的属性用buff，标识状态有无的用attribute
        "text": "隶属于礼貌帮",
        //表述文本
        "tips": "",
        //策划自己看的备注
        "resource": "tag_ToppatClan",
        //tag的图标，配置对应图标的资源名。对应资源的放置在mod要求的对应文件地址中
        "can_add": 0,
        //设置当前tag是否可以堆叠，1为可堆叠，0为不可堆叠。不可堆叠无论怎么加都是1
        "can_visible": 1,
        //设置玩家是否可见，1为可见，0为不可见。
        "can_inherit": 0,
        //设置当前标签是否可以通过装备继承到被装备的卡牌上，1为可以，0为不可以
        //策划就是通过这个参数实现，将武器卡牌上的属性加到装备者的身上的
        "can_nagative_and_zero": 0,
        //设置当前tag的负值是否有意义，1为有意义，0为无意义
        //设置为1时，tag的值就支持负数，否则最小值就是0
        "fail_tag": [],
        //参数要保留，但没有用，不用配置
        "tag_vanishing": 0,
        //参数要保留，但没有用，不用配置
        "tag_sfx": "",
        //用来设置带有了这个tag的卡牌，卡面会添加上对应的特效
        //暂不开放编辑
        "tag_rank": 98,
        //tag在卡牌上的显示顺序，数字越大越靠前
        "attributes": {
          "吸附指定": 1
          //配置了吸附指定，带有这个tag的卡牌，只能放入要求这个tag的仪式槽位中，无法被其他仪式槽位使用}
        },
      },
